generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  CONVERTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  userId         Int             @id @unique @default(autoincrement())
  forename       String          @db.VarChar(100)
  surname        String          @db.VarChar(100)
  email          String          @unique
  passwordHash   String          @map("password_hash")
  passwordResetTokenHash String?  @unique
  passwordResetExpiresAt DateTime?
  createdAt      DateTime        @default(now()) @map("created_at")
  modifiedAt     DateTime        @default(now()) @updatedAt @map("modified_at")
  addressLine1   String          @db.VarChar(255)
  addressLine2   String          @db.VarChar(255)
  city           String          @db.VarChar(100)
  postcode       String          @db.VarChar(10)
  status         UserStatus      @default(ACTIVE)
  orders         Order[]
  paymentDetails PaymentDetail[]
  basket        Basket?
  reservations  Reservation[]
}

model Product {
  productId   Int               @id @unique @default(autoincrement()) @map("prodid")
  name        String            @db.VarChar(100)
  category    String            @default("Uncategorised") @db.VarChar(100)
  description String            @db.VarChar(255)
  price       Decimal           @db.Decimal(10, 2)
  createdAt   DateTime          @default(now()) @map("created_at")
  modifiedAt  DateTime          @default(now()) @updatedAt @map("modified_at")
  imageURL    String            @map("image") @db.VarChar(255)
  suppliers   ProductSupplier[]
  inventory   Inventory[]
  basketItems BasketItem[]
  orderItems  OrderItem[]
  images      ProductImage[]
  reservationItems ReservationItem[]


  @@index([name])
}

model AdminUser {
  adminId      Int      @id @default(autoincrement())
  forename     String   @db.VarChar(100)
  surname      String   @db.VarChar(100)
  email        String   @unique
  role         String   @db.VarChar(50)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  modifiedAt   DateTime @default(now()) @updatedAt @map("modified_at")
}

model RefreshSession {
  id            String   @id
  principalId   Int
  principalKind String
  tokenHash     String
  expiresAt     DateTime
  revokedAt     DateTime?

  @@index([expiresAt])
}

model Inventory {
  inventoryId     Int      @id @unique @default(autoincrement()) @map("inventory_id")
  quantity        Int      @default(0)
  reservedQuantity Int     @default(0) @map("reserved_quantity")
  maximumQuantity Int      @default(0) @map("qty_limit")
  reorderLevel    Int      @default(0) @map("reorder_level")
  modifiedAt      DateTime @default(now()) @updatedAt @map("modified_at")
  marketValue     Decimal  @map("market_value") @db.Decimal(10, 2)
  productId       Int      @map("product_id")
  product         Product  @relation(fields: [productId], references: [productId])
  supplierId      Int      @map("supplier_id")
  supplier        Supplier @relation(fields: [supplierId], references: [supplierId])
  reservationAllocations ReservationInventoryAllocation[]

  @@index([reservedQuantity])
}

model ReservationInventoryAllocation {
  allocationId      Int             @id @default(autoincrement()) @map("allocation_id")
  reservationItemId Int             @map("reservation_item_id")
  reservationItem   ReservationItem @relation(fields: [reservationItemId], references: [reservationItemId], onDelete: Cascade)
  inventoryId       Int             @map("inventory_id")
  inventory         Inventory       @relation(fields: [inventoryId], references: [inventoryId], onDelete: Restrict)
  quantity          Int

  @@unique([reservationItemId, inventoryId])
  @@index([inventoryId])
}

model Order {
  orderId       Int         @id @unique @default(autoincrement()) @map("order_id")
  orderPlacedAt DateTime    @default(now()) @map("order_placed_at")
  orderStatus   OrderStatus @default(PENDING) @map("order_status")
  cost          Decimal     @map("cost") @db.Decimal(10, 2)
  shippingFee   Decimal     @default(20.00) @map("shipping_fee") @db.Decimal(10, 2)
  modifiedAt    DateTime    @default(now()) @updatedAt @map("modified_at")
  userId        Int
  user          User        @relation(fields: [userId], references: [userId])
  orderItems    OrderItem[]
  reservation   Reservation?

  @@index([orderStatus])
}

model Supplier {
  supplierId Int               @id @default(autoincrement()) @map("supplier_id")
  name       String            @unique @db.VarChar(100)
  products   ProductSupplier[]
  email      String            @unique @map("email") @db.VarChar(100)
  address    String            @db.VarChar(255)
  inventory  Inventory[]
}

model ProductSupplier {
  productId  Int
  supplierId Int
  product    Product  @relation(fields: [productId], references: [productId])
  supplier   Supplier @relation(fields: [supplierId], references: [supplierId])

  @@id([productId, supplierId])
}

model OrderItem {
  orderId   Int
  productId Int
  quantity  Int     @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [orderId])
  product   Product @relation(fields: [productId], references: [productId])

  @@id([orderId, productId])
}

model PaymentDetail {
  paymentId      Int           @id @unique @default(autoincrement()) @map("payment_id")
  paymentMethod  PaymentMethod @map("payment_method")
  cardName       String        @map("card_name") @db.VarChar(100)
  cardNumber     String        @map("card_number") @db.VarChar(16)
  expirationDate String        @map("expiration_date") @db.VarChar(7)
  user           User          @relation(fields: [userId], references: [userId])
  userId     Int
}

model Basket {
  basketId  Int       @id @unique @default(autoincrement()) @map("basket_id")
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  items     BasketItem[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
}

model BasketItem {
  basketItemId Int    @id @unique @default(autoincrement()) @map("basket_item_id")
  basketId     Int
  basket       Basket @relation(fields: [basketId], references: [basketId], onDelete: Cascade)
  productId    Int
  product      Product @relation(fields: [productId], references: [productId])
  quantity     Int
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([basketId, productId])
}

model ProductImage {
  imageId   Int     @id @default(autoincrement()) @map("image_id")
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  url       String  @db.VarChar(255)
  altText   String? @map("alt_text") @db.VarChar(255)
  position  Int     @default(0)

  @@unique([productId, position])
}


// Reservations are kept as history; only one ACTIVE reservation per user is allowed
// (enforced by the partial unique index "Reservation_userId_active_key" in migration 20261105100000).
model Reservation {
  reservationId  Int               @id @unique @default(autoincrement()) @map("reservation_id")
  userId         Int
  user           User              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  items          ReservationItem[]
  status         ReservationStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at")
  expiresAt      DateTime          @map("expiresAt")
  releasedAt     DateTime?         @map("released_at")
  orderId        Int?              @unique @map("order_id")
  order          Order?            @relation(fields: [orderId], references: [orderId], onDelete: SetNull)

  @@index([expiresAt])
  @@index([status, expiresAt])
  @@index([userId, status])
}

model ReservationItem {
  reservationItemId Int    @id @unique @default(autoincrement()) @map("reservation_item_id")
  reservationId     Int
  reservation       Reservation @relation(fields: [reservationId], references: [reservationId], onDelete: Cascade)
  productId    Int
  product      Product @relation(fields: [productId], references: [productId])
  quantity     Int
  createdAt    DateTime @default(now()) @map("created_at")
  inventoryAllocations ReservationInventoryAllocation[]

  @@unique([reservationId, productId])
}
