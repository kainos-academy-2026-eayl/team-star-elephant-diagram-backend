generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  forename     String   @db.VarChar(100)
  surname      String   @db.VarChar(100)
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  modifiedAt   DateTime @default(now()) @updatedAt @map("modified_at")
}

model Product {
  prod_id     Int      @id @default(autoincrement()) @map("prodid")
  name        String   @db.VarChar(100)
  category    String   @default("Uncategorised") @db.VarChar(100)
  description String   @db.VarChar(255)
  price       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  modifiedAt  DateTime @default(now()) @updatedAt @map("modified_at")
  imageURL    String   @map("image") @db.VarChar(255)
}

model AdminUser {
  AdminID      Int      @id @default(autoincrement())
  forename     String   @db.VarChar(100)
  surname      String   @db.VarChar(100)
  email        String   @unique
  role         String   @db.VarChar(50)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  modifiedAt   DateTime @default(now()) @updatedAt @map("modified_at")
}
